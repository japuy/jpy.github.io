{
  "installCommand": "NPM_CONFIG_ALLOW_SCRIPTS=* NPM_CONFIG_IGNORE_SCRIPTS=false npm install --ignore-scripts=false --foreground-scripts",
  "buildCommand": "NPM_CONFIG_ALLOW_SCRIPTS=* node node_modules/esbuild/install.js 2>/dev/null; npm run build:fast",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
